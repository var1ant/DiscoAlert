# Copy this file to config.env and fill in the values after each = sign.
# No quotes, no spaces. Never commit config.env: it holds your tokens.

# Bot token from the Discord Developer Portal (Bot > Reset Token)
DISCORD_BOT_TOKEN=
# Right-click the channel in Discord (Developer Mode on) > Copy Channel ID
DISCORD_CHANNEL_ID=

# Token from @BotFather in Telegram
TELEGRAM_BOT_TOKEN=
# Your chat ID. Leave empty on first run: the installer (or "node watcher.js --find-chat") finds it.
TELEGRAM_CHAT_ID=

# Optional. Comma-separated words, e.g. restock,preorder. Empty = alert on every message.
KEYWORDS=
# true = skip messages posted by bots and webhooks
IGNORE_BOTS=false
# Seconds between checks. Minimum 10.
POLL_SECONDS=60
