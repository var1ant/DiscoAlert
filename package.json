{
  "name": "discord-telegram-watcher",
  "version": "1.0.0",
  "description": "Forward new messages from a Discord channel to Telegram. No dependencies.",
  "main": "watcher.js",
  "scripts": {
    "start": "node watcher.js",
    "check": "node watcher.js --check",
    "find-chat": "node watcher.js --find-chat"
  },
  "engines": {
    "node": ">=14"
  },
  "keywords": ["discord", "telegram", "alerts", "bot", "notifications"],
  "license": "MIT"
}
